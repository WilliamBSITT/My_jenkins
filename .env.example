# Copy this file to .env and fill the values before running docker compose
# Jenkins admin password
JENKINS_ADMIN_PASSWORD=changeme_admin_password

# Jenkins developer password
JENKINS_DEVELOPER_PASSWORD=changeme_developer_password

# Ngrok token (optional if you don't use ngrok)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional domain for ngrok (if used)
NGROK_DOMAIN=your-domain.ngrok.app

# Optional email for ngrok (if used) 
NGROK_ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com
